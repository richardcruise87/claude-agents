{
  "comment": "Copy this file to config.json and customise for your environment",
  "model": "claude-sonnet-4-6",
  "model_provider": "anthropic",
  "triage_reports_dir": "~/octavia_bug_triages",
  "reproduction_reports_dir": "~/octavia_bug_reproductions",
  "proposals_output_dir": "~/octavia_fix_proposals",
  "proposal_tracking_file": "~/.octavia_fix_proposals.json",
  "devstack_path": "/opt/stack",
  "launchpad_project": "octavia",
  "max_proposals_per_run": 2,
  "cutoff_date": null,
  "comment_cutoff": "null = 30 days ago; set to YYYY-MM-DD to override",
  "gerrit": {
    "push_wip_draft": false,
    "comment_push": "Set push_wip_draft=true to push the patch to Gerrit as a WIP change",
    "base_url": "https://review.opendev.org",
    "username_env": "GERRIT_USERNAME",
    "token_env": "GERRIT_HTTP_PASSWORD"
  },
  "feedback": {
    "post_to_launchpad": false,
    "read_launchpad_comments": false,
    "read_gerrit_comments": false,
    "comment_feedback": "Online feedback sources are disabled by default",
    "consumer_key_env": "LAUNCHPAD_CONSUMER_KEY",
    "access_token_env": "LAUNCHPAD_ACCESS_TOKEN",
    "access_token_secret_env": "LAUNCHPAD_ACCESS_TOKEN_SECRET"
  },
  "notifications": {
    "enabled": true,
    "comment": "Set enabled=true and configure notifications.json in repo root"
  }
}
