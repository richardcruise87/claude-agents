[Unit]
Description=Octavia Code Review Agent Timer
Documentation=https://github.com/richardcruise87/claude-agents
Requires=octavia-code-review.service

[Timer]
# Run every 4 hours
OnCalendar=00/4:00:00

# Alternative schedules (comment/uncomment as needed):
# Every hour:
# OnCalendar=hourly

# Every 2 hours:
# OnCalendar=00/2:00:00

# Twice daily (10 AM and 3 PM):
# OnCalendar=*-*-* 10:00:00
# OnCalendar=*-*-* 15:00:00

# Weekdays during business hours (9 AM - 5 PM, every 2 hours):
# OnCalendar=Mon..Fri *-*-* 09,11,13,15,17:00:00

# Run on boot if missed (e.g., system was off)
Persistent=true

# Add randomization to avoid thundering herd (optional)
# RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
