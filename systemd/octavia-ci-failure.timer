[Unit]
Description=Run OpenStack CI Failure Analysis Agent every 4 hours
Documentation=https://github.com/richardcruise87/claude-agents

[Timer]
# Run every 4 hours
OnCalendar=00/4:00:00

# Run missed jobs if system was off
Persistent=true

# Other schedules (uncomment one to use):
# OnCalendar=hourly
# OnCalendar=00/2:00:00
# OnCalendar=Mon..Fri *-*-* 09:00:00

Unit=octavia-ci-failure.service

[Install]
WantedBy=timers.target
