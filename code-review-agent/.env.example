# Environment Variables for Octavia Review Agent
# Copy this file to .env and customize, or export these directly

# Required: Vertex AI configuration
export CLAUDE_CODE_USE_VERTEX=1

# Optional: Google Cloud service account (if not using gcloud auth)
# export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Override config.json settings
# export DEVSTACK_PATH=/custom/path/to/devstack
# export REVIEWS_OUTPUT_DIR=/custom/output/directory
# export GERRIT_URL=https://review.opendev.org
# export MAX_REVIEWS=5

# Usage:
# source .env.example
# or
# export $(cat .env | grep -v '^#' | xargs)
