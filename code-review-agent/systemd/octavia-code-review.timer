[Unit]
Description=Octavia Code Review Agent Timer
Documentation=https://github.com/richardcruise87/claude-agents

[Timer]
# Run every 4 hours
OnCalendar=00/4:00:00

# Alternative schedules (uncomment one):
# Every hour:            OnCalendar=hourly
# Every 2 hours:         OnCalendar=00/2:00:00
# Weekdays 9 AM - 5 PM:  OnCalendar=Mon..Fri *-*-* 09,11,13,15,17:00:00

# Run if the system was off at the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
