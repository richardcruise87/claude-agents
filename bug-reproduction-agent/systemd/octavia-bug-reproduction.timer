[Unit]
Description=Octavia Bug Reproduction Agent Timer
Documentation=https://github.com/richardcruise87/claude-agents

[Timer]
# Run daily at midday — catches any triage reports missed by the path watcher
OnCalendar=*-*-* 12:00:00

# Alternative schedules (uncomment one):
# Every 6 hours:     OnCalendar=00/6:00:00
# Twice daily:       OnCalendar=*-*-* 09:00:00
#                    OnCalendar=*-*-* 17:00:00

# Run if the system was off at the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
