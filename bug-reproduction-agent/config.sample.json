{
  "comment": "Copy this file to config.json and customize for your environment",
  "model": "claude-sonnet-4-6",
  "model_provider": "anthropic",
  "triage_reports_dir": "~/octavia_bug_triages",
  "reproductions_output_dir": "~/octavia_bug_reproductions",
  "reproduction_tracking_file": "~/.octavia_bug_reproductions.json",
  "devstack": {
    "path": "/opt/stack",
    "openrc_file": "/opt/stack/devstack/openrc",
    "required_services": [
      "devstack@o-api.service",
      "devstack@o-cw.service",
      "devstack@o-hm.service",
      "devstack@keystone.service",
      "devstack@n-api.service",
      "devstack@q-svc.service"
    ],
    "health_timeout": 30,
    "min_disk_space_gb": 10,
    "comment": "DevStack configuration and health check requirements"
  },
  "reproduction": {
    "max_attempts": 3,
    "script_timeout": 600,
    "cleanup_after_attempt": true,
    "working_directory": "/tmp/octavia-reproductions",
    "comment": "Reproduction attempt settings"
  },
  "cutoff_date": null,
  "comment2": "Cutoff date (YYYY-MM-DD) for processing triages. Defaults to 30 days ago if null.",
  "notifications": {
    "enabled": false,
    "comment": "Set enabled=true and copy notifications.sample.json to notifications.json in the repo root"
  },
  "context": {
    "rules_file": "~/.claude-agents/rules.md",
    "global_context_file": "~/.claude-agents/global_context.md",
    "agent_context_file": "~/.claude-agents/bug_reproduction_context.md",
    "extra_files": [],
    "max_chars_per_file": 2000,
    "save_learnings": true,
    "comment": "Context files are read before each AI call. Learnings are appended after notable outcomes. rules_file is read-only (agents never write it)."
  },
  "feedback": {
    "post_summary": false
  }
}