[Unit]
Description=Octavia Bug Triage Agent
Documentation=https://github.com/richardcruise87/claude-agents
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/git/claude-agents/bug-triage-agent

ExecStart=%h/.venv/claude-agents/bin/octavia-triage-bugs

EnvironmentFile=-%h/.config/claude-agents/credentials.env
Environment="CLAUDE_CODE_USE_VERTEX=1"
Environment="PYTHONUNBUFFERED=1"
# Environment="CUTOFF_DATE=2026-03-01"
# Environment="MAX_BUGS=5"

StandardOutput=append:%h/octavia-logs/octavia-bug-triage.log
StandardError=append:%h/octavia-logs/octavia-bug-triage.log
SyslogIdentifier=octavia-bug-triage

# MemoryMax=2G
# CPUQuota=50%

[Install]
WantedBy=default.target
