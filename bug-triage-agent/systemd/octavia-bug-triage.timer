[Unit]
Description=Octavia Bug Triage Agent Timer
Documentation=https://github.com/richardcruise87/claude-agents

[Timer]
# Run daily at 9:00 AM
OnCalendar=*-*-* 09:00:00

# Alternative schedules (uncomment one):
# Every 6 hours:     OnCalendar=00/6:00:00
# Weekdays at 9 AM:  OnCalendar=Mon..Fri *-*-* 09:00:00

# Run if the system was off at the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
